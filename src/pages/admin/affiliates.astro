---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import { requireAdminPage } from "../../lib/adminAuth";
import { createSupabaseAdminClient } from "../../lib/supabase/admin";

const denied = await requireAdminPage(Astro);
if (denied) return denied;

const admin = createSupabaseAdminClient();
const csrfToken = Astro.locals.csrfToken ?? "";
const error = Astro.url.searchParams.get("error");
const created = Astro.url.searchParams.get("created") === "1";
const paid = Astro.url.searchParams.get("paid") === "1";

type AffiliateRow = {
  id: string;
  code: string;
  name: string;
  email: string | null;
  commission_pct: number;
  status: string;
  created_at: string;
};
type ReferralRow = {
  id: string;
  affiliate_id: string;
  stripe_session_id: string;
  kind: string;
  amount_cents: number;
  commission_cents: number;
  status: string;
  created_at: string;
};

let affiliates: AffiliateRow[] = [];
let referrals: ReferralRow[] = [];

if (admin) {
  const [{ data: affiliateData }, { data: referralData }] = await Promise.all([
    admin.from("affiliates").select("id,code,name,email,commission_pct,status,created_at").order("created_at", { ascending: false }),
    admin
      .from("affiliate_referrals")
      .select("id,affiliate_id,stripe_session_id,kind,amount_cents,commission_cents,status,created_at")
      .order("created_at", { ascending: false }),
  ]);
  affiliates = (affiliateData as AffiliateRow[] | null) ?? [];
  referrals = (referralData as ReferralRow[] | null) ?? [];
}

const referralsByAffiliate = new Map<string, ReferralRow[]>();
for (const r of referrals) {
  const list = referralsByAffiliate.get(r.affiliate_id) ?? [];
  list.push(r);
  referralsByAffiliate.set(r.affiliate_id, list);
}

function money(cents: number) {
  return `$${(cents / 100).toFixed(2)}`;
}
---

<BaseLayout title="Admin - Affiliates" noindex={true}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-3xl font-semibold text-slate-100">Affiliates</h1>
      <a class="text-sm text-sky-200 hover:underline" href="/admin">Back to dashboard</a>
    </div>

    <p class="mb-6 text-sm text-slate-400">
      Share a link like <code class="rounded bg-white/10 px-1.5 py-0.5">https://yourdomain.com/?ref=CODE</code> with a
      partner. First-touch attribution is cookied for 60 days; a conversion is recorded automatically when that
      visitor completes a Stripe checkout (subscription or report unlock).
    </p>

    {error ? (
      <p class="mb-4 rounded-2xl border border-rose-400/30 bg-rose-400/10 px-4 py-3 text-sm text-rose-100">{error}</p>
    ) : null}
    {created ? (
      <p class="mb-4 rounded-2xl border border-emerald-300/30 bg-emerald-300/10 px-4 py-3 text-sm text-emerald-100">Affiliate created.</p>
    ) : null}
    {paid ? (
      <p class="mb-4 rounded-2xl border border-emerald-300/30 bg-emerald-300/10 px-4 py-3 text-sm text-emerald-100">Marked paid.</p>
    ) : null}

    <Card class="mb-8">
      <h2 class="text-lg text-slate-100">Add an affiliate</h2>
      <form method="post" action="/api/admin/create-affiliate" class="mt-4 grid gap-3 sm:grid-cols-2">
        <input type="hidden" name="_csrf" value={csrfToken} />
        <input
          class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-100"
          type="text"
          name="code"
          placeholder="Code (e.g. alexspeed)"
          required
        />
        <input
          class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-100"
          type="text"
          name="name"
          placeholder="Partner name"
          required
        />
        <input
          class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-100"
          type="email"
          name="email"
          placeholder="Email (optional)"
        />
        <input
          class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-100"
          type="number"
          name="commissionPct"
          min="0"
          max="100"
          step="1"
          value="20"
          placeholder="Commission %"
        />
        <Button type="submit" class="sm:col-span-2">Create</Button>
      </form>
    </Card>

    {!admin ? (
      <Card><p class="text-slate-300">Supabase admin client is unavailable.</p></Card>
    ) : affiliates.length === 0 ? (
      <Card><p class="text-slate-300">No affiliates yet - add one above.</p></Card>
    ) : (
      <div class="space-y-6">
        {affiliates.map((a) => {
          const rows = referralsByAffiliate.get(a.id) ?? [];
          const totalOwed = rows.filter((r) => r.status === "unpaid").reduce((sum, r) => sum + r.commission_cents, 0);
          const totalPaid = rows.filter((r) => r.status === "paid").reduce((sum, r) => sum + r.commission_cents, 0);
          return (
            <Card>
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <div class="flex items-center gap-3">
                    <h3 class="text-xl text-slate-100">{a.name}</h3>
                    <Badge tone={a.status === "active" ? "success" : "neutral"}>{a.status}</Badge>
                  </div>
                  <p class="mt-1 text-sm text-slate-400">
                    code <code class="rounded bg-white/10 px-1.5 py-0.5">{a.code}</code>
                    {a.email ? ` · ${a.email}` : ""} · {a.commission_pct}% commission
                  </p>
                </div>
                <div class="text-right text-sm">
                  <p class="text-slate-400">Owed: <span class="text-amber-200">{money(totalOwed)}</span></p>
                  <p class="text-slate-500">Paid out: {money(totalPaid)}</p>
                </div>
              </div>

              {rows.length === 0 ? (
                <p class="mt-4 text-sm text-slate-500">No conversions yet.</p>
              ) : (
                <div class="mt-4 overflow-x-auto">
                  <table class="w-full text-left text-sm">
                    <thead>
                      <tr class="text-xs uppercase tracking-[0.14em] text-slate-500">
                        <th class="pb-2 pr-4">Date</th>
                        <th class="pb-2 pr-4">Kind</th>
                        <th class="pb-2 pr-4">Amount</th>
                        <th class="pb-2 pr-4">Commission</th>
                        <th class="pb-2 pr-4">Status</th>
                        <th class="pb-2"></th>
                      </tr>
                    </thead>
                    <tbody>
                      {rows.map((r) => (
                        <tr class="border-t border-white/5">
                          <td class="py-2 pr-4 text-slate-300">{new Date(r.created_at).toLocaleDateString()}</td>
                          <td class="py-2 pr-4 text-slate-300">{r.kind === "subscription" ? "Subscription" : "Report unlock"}</td>
                          <td class="py-2 pr-4 text-slate-300">{money(r.amount_cents)}</td>
                          <td class="py-2 pr-4 text-emerald-200">{money(r.commission_cents)}</td>
                          <td class="py-2 pr-4">
                            <Badge tone={r.status === "paid" ? "success" : "warning"}>{r.status}</Badge>
                          </td>
                          <td class="py-2">
                            {r.status === "unpaid" ? (
                              <form method="post" action="/api/admin/mark-referral-paid">
                                <input type="hidden" name="_csrf" value={csrfToken} />
                                <input type="hidden" name="referralId" value={r.id} />
                                <button type="submit" class="text-xs text-sky-200 hover:underline">Mark paid</button>
                              </form>
                            ) : null}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </Card>
          );
        })}
      </div>
    )}
  </section>
</BaseLayout>
