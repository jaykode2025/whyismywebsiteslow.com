---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import { requireAdminPage } from "../../lib/adminAuth";
import { createSupabaseAdminClient } from "../../lib/supabase/admin";

const denied = await requireAdminPage(Astro);
if (denied) return denied;

const admin = createSupabaseAdminClient();

const now = Date.now();
const last7Iso = new Date(now - 7 * 24 * 60 * 60 * 1000).toISOString();

type ScanRow = {
  id: string;
  url: string;
  status: string;
  error: string | null;
  created_at: string;
};

let recentScans: ScanRow[] = [];
let failedLast7 = 0;
let scansLast7 = 0;
let activeSubscribers = 0;
let totalUsers = 0;

if (admin) {
  const [{ data: scansData }, { count: failedCount }, { count: scansCount }, { count: subsCount }, { count: usersCount }] =
    await Promise.all([
      admin
        .from("scans")
        .select("id,url,status,error,created_at")
        .order("created_at", { ascending: false })
        .limit(20),
      admin.from("scans").select("id", { count: "exact", head: true }).eq("status", "failed").gte("created_at", last7Iso),
      admin.from("scans").select("id", { count: "exact", head: true }).gte("created_at", last7Iso),
      admin.from("subscriptions").select("user_id", { count: "exact", head: true }).in("status", ["active", "trialing", "past_due"]),
      admin.from("profiles").select("id", { count: "exact", head: true }),
    ]);

  recentScans = (scansData as ScanRow[]) ?? [];
  failedLast7 = failedCount ?? 0;
  scansLast7 = scansCount ?? 0;
  activeSubscribers = subsCount ?? 0;
  totalUsers = usersCount ?? 0;
}

const statusColor: Record<string, string> = {
  done: "text-emerald-300",
  failed: "text-rose-300",
  queued: "text-amber-300",
  running: "text-sky-300",
};
---

<BaseLayout title="Admin" noindex={true}>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-3xl font-semibold text-slate-100">Admin</h1>
      <nav class="flex gap-3 text-sm">
        <a class="text-sky-200 hover:underline" href="/admin/users">Users</a>
        <a class="text-sky-200 hover:underline" href="/admin/reports">Reports</a>
        <a class="text-sky-200 hover:underline" href="/internal/funnel">Funnel</a>
      </nav>
    </div>

    {!admin ? (
      <Card><p class="text-slate-300">Supabase admin client is unavailable. Set `SUPABASE_SERVICE_ROLE_KEY`.</p></Card>
    ) : (
      <>
        <div class="grid gap-4 sm:grid-cols-4">
          <Card><p class="text-xs uppercase tracking-[0.14em] text-slate-500">Total users</p><p class="mt-2 text-2xl text-slate-100">{totalUsers}</p></Card>
          <Card><p class="text-xs uppercase tracking-[0.14em] text-slate-500">Active subscribers</p><p class="mt-2 text-2xl text-slate-100">{activeSubscribers}</p></Card>
          <Card><p class="text-xs uppercase tracking-[0.14em] text-slate-500">Scans, last 7 days</p><p class="mt-2 text-2xl text-slate-100">{scansLast7}</p></Card>
          <Card class={failedLast7 > 0 ? "border-rose-400/30" : ""}>
            <p class="text-xs uppercase tracking-[0.14em] text-slate-500">Failed scans, last 7 days</p>
            <p class={`mt-2 text-2xl ${failedLast7 > 0 ? "text-rose-300" : "text-slate-100"}`}>{failedLast7}</p>
          </Card>
        </div>

        <Card class="mt-6">
          <p class="mb-4 text-xs uppercase tracking-[0.14em] text-slate-500">Recent scans</p>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[640px] text-left text-sm">
              <thead>
                <tr class="border-b border-white/10 text-xs uppercase tracking-[0.1em] text-slate-500">
                  <th class="py-2 pr-4">URL</th>
                  <th class="py-2 pr-4">Status</th>
                  <th class="py-2 pr-4">When</th>
                  <th class="py-2">Report</th>
                </tr>
              </thead>
              <tbody>
                {recentScans.map((scan) => (
                  <tr class="border-b border-white/5">
                    <td class="max-w-[280px] truncate py-2 pr-4 text-slate-300" title={scan.url}>{scan.url}</td>
                    <td class={`py-2 pr-4 ${statusColor[scan.status] ?? "text-slate-300"}`}>
                      {scan.status}
                      {scan.error ? <span class="ml-2 text-xs text-slate-500" title={scan.error}>({scan.error.slice(0, 40)})</span> : null}
                    </td>
                    <td class="py-2 pr-4 text-slate-400">{new Date(scan.created_at).toLocaleString()}</td>
                    <td class="py-2">
                      <a class="text-sky-300 hover:underline" href={`/admin/reports?id=${scan.id}`}>Open</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Card>
      </>
    )}
  </section>
</BaseLayout>
