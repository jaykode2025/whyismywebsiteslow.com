---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteUrl, breadcrumb, jsonLd, buildSeoTitle, buildSeoDescription } from "../../lib/seo";

export const prerender = true;

const guides = (await getCollection("pages")).sort((a, b) => {
  const aDate = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
  const bDate = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
  return bDate - aDate;
});

const pageTitle = buildSeoTitle("Website Speed Guides");
const description = buildSeoDescription(
  "Plain-English guides on why specific platforms and setups run slow, with a free scan on every page."
);
const canonical = siteUrl("/guides/");
const crumbs = [{ name: "Home", item: "/" }, { name: "Guides" }];
---

<BaseLayout title={pageTitle} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd(breadcrumb(crumbs))} />
  </Fragment>

  <section class="mx-auto max-w-4xl px-4 py-12">
    <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Guides</p>
    <h1 class="mt-2 text-3xl font-semibold text-slate-100">Website speed guides</h1>
    <p class="mt-3 max-w-2xl text-sm text-slate-400">
      What's actually slowing down specific platforms and setups, in plain English - plus a free scan
      on every guide so you can check your own site while you read.
    </p>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {guides.map((guide) => (
        <li>
          <a
            href={`/guides/${guide.id}/`}
            class="flex h-full flex-col rounded-2xl border border-white/10 bg-white/5 p-5 transition hover:border-sky-400/40 hover:bg-white/[0.07]"
          >
            <span class="text-lg text-slate-100">{guide.data.title}</span>
            <span class="mt-2 text-sm text-slate-400">{guide.data.description}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-10 rounded-2xl border border-white/10 bg-white/5 p-6 text-sm text-slate-300">
      Looking for a specific platform or industry instead?
      <a href="/website-speed-audit/" class="text-sky-300 hover:text-sky-200">Browse the full speed audit library</a>
      or <a href="/scan" class="text-sky-300 hover:text-sky-200">run a free scan</a> on your own site.
    </div>
  </section>
</BaseLayout>
