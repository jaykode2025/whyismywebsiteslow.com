---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";

const supabase = Astro.locals.supabase;
const code = Astro.url.searchParams.get("code");
const errorParam = Astro.url.searchParams.get("error");

let exchangeError: string | null = errorParam;

// The password-reset email links here with ?code=... (PKCE flow via
// @supabase/ssr). Exchanging it server-side establishes a real session
// (via the same cookie-setting mechanism middleware.ts uses), so the
// password can then be updated through the normal authenticated
// /api/account/update-password route - no separate "recovery" endpoint
// needed.
if (code && supabase && !exchangeError) {
  const { error } = await supabase.auth.exchangeCodeForSession(code);
  if (error) exchangeError = error.message;
}

const { data } = supabase ? await supabase.auth.getUser() : { data: { user: null } };
const hasSession = Boolean(data?.user);
const csrfToken = Astro.locals.csrfToken ?? "";
---

<BaseLayout title="Set a new password" description="Choose a new password for your account.">
  <section class="mx-auto max-w-md px-4 py-16">
    <h1 class="text-3xl font-semibold text-slate-100">Set a new password</h1>

    {!hasSession ? (
      <div class="mt-6 space-y-4">
        <p class="rounded-2xl border border-rose-400/20 bg-rose-400/5 px-4 py-3 text-sm text-rose-200">
          {exchangeError
            ? `This reset link is invalid or has expired: ${exchangeError}`
            : "This reset link is invalid or has expired."}
        </p>
        <Button href="/forgot-password" class="w-full rounded-xl">Request a new link</Button>
      </div>
    ) : (
      <form class="mt-8 space-y-4" method="post" action="/api/account/update-password">
        <input type="hidden" name="_csrf" value={csrfToken} />
        <input type="hidden" name="redirectTo" value="/login?reset=1" />

        <label class="block text-sm text-slate-300">
          New password
          <input
            class="mt-2 w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-slate-100"
            type="password"
            name="password"
            required
            minlength="8"
            autocomplete="new-password"
          />
        </label>

        <Button type="submit" size="lg" class="w-full rounded-xl">
          Update password
        </Button>
      </form>
    )}
  </section>
</BaseLayout>
