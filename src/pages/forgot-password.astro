---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";

const sent = Astro.url.searchParams.get("sent") === "1";
---

<BaseLayout title="Reset your password" description="Request a password reset link.">
  <section class="mx-auto max-w-md px-4 py-16">
    <h1 class="text-3xl font-semibold text-slate-100">Reset your password</h1>

    {sent ? (
      <p class="mt-6 rounded-2xl border border-emerald-300/30 bg-emerald-300/10 px-4 py-3 text-sm text-emerald-100">
        If an account exists for that email, we've sent a link to reset your password. It may take a
        minute to arrive - check spam if you don't see it.
      </p>
    ) : (
      <>
        <p class="mt-2 text-sm text-slate-400">
          Enter the email you signed up with and we'll send you a link to reset your password.
        </p>

        <form class="mt-8 space-y-4" method="post" action="/api/auth/forgot-password">
          <label class="block text-sm text-slate-300">
            Email
            <input
              class="mt-2 w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-slate-100"
              type="email"
              name="email"
              required
              autocomplete="email"
            />
          </label>

          <Button type="submit" size="lg" class="w-full rounded-xl">
            Send reset link
          </Button>
        </form>
      </>
    )}

    <p class="mt-6 text-sm text-slate-400">
      <a class="text-sky-200 hover:underline" href="/login">Back to log in</a>
    </p>
  </section>
</BaseLayout>
